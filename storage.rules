rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Auxiliary auth & role functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isApprovedTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'teacher' && request.auth.token.isApprovedForTutoring == true)
      );
    }

    // Maximum file size validation (in MB)
    function maxFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // 1. Profile Pictures (Avatars)
    match /avatars/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() 
                   && (fileName.matches('^' + request.auth.uid + '_.*') || fileName == request.auth.uid)
                   && maxFileSize(5);
    }

    // 2. Personal Files (/users/{userId}/...)
    match /users/{userId}/{allPaths=**} {
      allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
      allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && maxFileSize(25);
    }

    // 3. Student Private Notes (/notes/{userId}/...)
    match /notes/{userId}/{fileName} {
      allow read: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && maxFileSize(15);
    }

    // 4. Chat Attachments (/chat_attachments/{conversationId}/...) - Restricted to Backend Signed URLs
    match /chat_attachments/{conversationId}/{fileName} {
      allow read, write: if isAdmin();
    }

    // 5. Course Materials (/course_materials/{courseId}/...) - Restricted to Backend Signed URLs for reads
    match /course_materials/{courseId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isApprovedTeacher() && maxFileSize(50);
    }

    // 6. Course Videos & Class Recordings (/videos/ and /recordings/)
    match /videos/{allPaths=**} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher() && maxFileSize(500);
    }

    match /recordings/{courseOrUserId}/{fileName} {
      allow read, write: if isAdmin();
    }

    match /recordings/{fileName} {
      allow read, write: if isAdmin();
    }

    // 7. Receipts (/receipts/{fileName})
    match /receipts/{fileName} {
      allow read: if isAdmin() || (isVerifiedUser() && fileName.matches('^' + request.auth.uid + '_.*'));
      allow write: if isVerifiedUser() && (fileName.matches('^' + request.auth.uid + '_.*') || isAdmin()) && maxFileSize(10);
    }

    // 8. Structured Attachments by User (/attachments/{userId}/{fileName})
    match /attachments/{userId}/{fileName} {
      allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher() || isAdmin());
      allow write: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher() || isAdmin()) && maxFileSize(25);
    }

    // 9. General Attachments with User UID Isolation (/attachments/{fileName})
    match /attachments/{fileName} {
      allow read: if isVerifiedUser() && (
        isAdmin() ||
        isApprovedTeacher() ||
        fileName.matches('^' + request.auth.uid + '_.*') ||
        fileName.matches('.*_' + request.auth.uid + '_.*') ||
        fileName.matches('.*_' + request.auth.uid + '\\..*') ||
        fileName.matches('.*_' + request.auth.uid + '$')
      );
      allow write: if isVerifiedUser() && maxFileSize(25) && (
        isAdmin() ||
        isApprovedTeacher() ||
        fileName.matches('^' + request.auth.uid + '_.*') ||
        fileName.matches('.*_' + request.auth.uid + '_.*') ||
        fileName.matches('.*_' + request.auth.uid + '\\..*') ||
        fileName.matches('.*_' + request.auth.uid + '$')
      );
    }

    // Default deny fallback
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
