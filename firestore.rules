rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isApprovedTeacher() {
      return isVerifiedUser() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'teacher' && request.auth.token.isApprovedForTutoring == true)
      );
    }

    // Helper to verify participant in communication structures
    function isParticipant(data) {
      return isVerifiedUser() && (
        isAdmin() ||
        (data != null && (
          (data.participants is list && request.auth.uid in data.participants) ||
          (data.participantIds is list && request.auth.uid in data.participantIds) ||
          (data.studentId is string && data.studentId == request.auth.uid) ||
          (data.teacherId is string && data.teacherId == request.auth.uid) ||
          (data.createdBy is string && data.createdBy == request.auth.uid) ||
          (data.senderId is string && data.senderId == request.auth.uid) ||
          (data.recipientId is string && data.recipientId == request.auth.uid) ||
          (data.userId is string && data.userId == request.auth.uid)
        ))
      );
    }

    function isIdParticipant(id) {
      return isVerifiedUser() && (
        isAdmin() ||
        id == request.auth.uid ||
        id.matches('^direct_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^peer_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^room_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^call_' + request.auth.uid + '(_.*)?$') ||
        id.matches('^' + request.auth.uid + '_.*') ||
        id.matches('.*_' + request.auth.uid + '$') ||
        id.matches('.*_' + request.auth.uid + '_.*')
      );
    }

    function isEnrolledInCourse(courseId) {
      return isVerifiedUser() && request.auth.token.role == 'student' &&
             courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrolledCourseIds', []);
    }

    function isTeacherOfCourse(courseId) {
      return isVerifiedUser() && request.auth.token.role == 'teacher' && (
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('taughtCourseIds', []) ||
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coursesTaughtIds', []) ||
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('levels', [])
      );
    }


    // 1. App Configuration (Public read, Admin write)
    match /app_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users Collection (/users/{userId} & /firestore_users/{userId})
    // Prevents privilege escalation: client cannot elevate to teacher/admin or self-approve tutoring
    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'student' &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == false)
      ) || isAdmin();
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == resource.data.isApprovedForTutoring)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    match /firestore_users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'student' &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == false)
      ) || isAdmin();
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
        (!('isApprovedForTutoring' in request.resource.data) || request.resource.data.isApprovedForTutoring == resource.data.isApprovedForTutoring)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    // Role-specific collections
    match /students/{userId} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
        allow write: if isVerifiedUser() && (isOwner(userId) || isApprovedTeacher());
      }
    }

    match /teachers/{teacherId} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() && (isOwner(teacherId) || isAdmin());
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser();
        allow write: if isVerifiedUser() && (isOwner(teacherId) || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 3. Courses, Levels, Subjects, Modules, Lessons, Videos, Quizzes
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /course_levels/{levelId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isApprovedTeacher();
      }
    }

    match /firestore_quizzes/{quizId} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher();
      match /{allSubcollections=**} {
        allow read: if isVerifiedUser();
        allow write: if isApprovedTeacher();
      }
    }

    match /quiz_answers/{answerId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(answerId));
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(answerId));
    }

    // 4. Tutoring Requests & Topic Requests
    match /firestore_tutoring_requests/{requestId} {
      allow read: if isVerifiedUser() && (isApprovedTeacher() || isParticipant(resource.data) || isIdParticipant(requestId));
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser() && (isApprovedTeacher() || isParticipant(resource.data) || isIdParticipant(requestId));
    }

    match /firestore_topic_requests/{requestId} {
      allow read: if isVerifiedUser() && (isAdmin() || isApprovedTeacher() || isParticipant(resource.data) || isIdParticipant(requestId));
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser() && (isAdmin() || isApprovedTeacher() || isParticipant(resource.data) || isIdParticipant(requestId));
    }

    match /exam_events/{eventId} {
      allow read: if isVerifiedUser();
      allow write: if isApprovedTeacher();
    }

    // 5. Communications, Rooms, Calls, Whiteboards
    // Aislamiento estricto de participantes
    match /chats/{chatId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(chatId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(chatId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /rooms/{roomId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(roomId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(roomId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /calls/{callId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(callId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(callId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /voice_group_calls/{callId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(callId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(callId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

match /whiteboards/{whiteboardId} {
      allow read, write: if isVerifiedUser() && (
        isAdmin() || 
        isApprovedTeacher() ||
        isIdParticipant(whiteboardId) || 
        isParticipant(resource.data) || 
        isEnrolledInCourse(whiteboardId) ||
        isTeacherOfCourse(whiteboardId)
      );
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (
          isAdmin() || 
          isApprovedTeacher() ||
          isIdParticipant(whiteboardId) || 
          isParticipant(resource.data) || 
          isEnrolledInCourse(whiteboardId) ||
          isTeacherOfCourse(whiteboardId)
        );
      }
    }

    match /whiteboardCursors/{cursorId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(cursorId) || isParticipant(resource.data) || isApprovedTeacher());
    }

    match /conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_direct_messages/{msgId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data) || isApprovedTeacher());
    }

    match /firestore_peer_conversations/{convId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      match /{allSubcollections=**} {
        allow read, write: if isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data) || isApprovedTeacher());
      }
    }

    match /firestore_peer_messages/{msgId} {
      allow read, write: if isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data) || isApprovedTeacher());
    }

    match /firestore_teacher_conversations/{convId} {
      allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data)));
      match /{allSubcollections=**} {
        allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(convId) || isParticipant(resource.data)));
      }
    }

    match /firestore_teacher_messages/{msgId} {
      allow read, write: if isApprovedTeacher() || (isVerifiedUser() && (isIdParticipant(msgId) || isParticipant(resource.data)));
    }

    // 6. Comments, Ratings, Transactions
    match /firestore_comments/{commentId} {
      allow read: if true;
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(commentId) || isApprovedTeacher());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(ratingId) || isApprovedTeacher());
    }

    match /infinity_transactions/{txId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(txId) || isAdmin());
      allow write: if isAdmin();
    }

    match /student_payments/{paymentId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(paymentId) || isAdmin());
      allow write: if isAdmin();
    }

    match /student_expenses/{expenseId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(expenseId) || isAdmin());
      allow write: if isAdmin();
    }

    match /teacher_payments/{paymentId} {
      allow read: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(paymentId) || isAdmin());
      allow write: if isAdmin();
    }

match /firestore_course_messages/{msgId} {
       allow read: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(resource.data.courseId) ||
         isTeacherOfCourse(resource.data.courseId)
       );
       allow create: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(request.resource.data.courseId) ||
         isTeacherOfCourse(request.resource.data.courseId)
       );
       allow update: if isVerifiedUser() && (
         isAdmin() ||
         (isEnrolledInCourse(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId) ||
         (isTeacherOfCourse(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId)
       );
       allow delete: if isVerifiedUser() && (
         isAdmin() ||
         isEnrolledInCourse(resource.data.courseId) ||
         isTeacherOfCourse(resource.data.courseId)
       );
    }

    match /firestore_closed_conversations/{convId} {
       allow read, write: if isApprovedTeacher() || isAdmin();
    }

    // 7. Student Data & Logs
    match /student_course_progress/{id} {
      allow read, write: if isVerifiedUser() && (id.startsWith(request.auth.uid) || isApprovedTeacher());
    }

    match /firestore_agenda_events/{id} {
      allow read, write: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(id));
    }

    match /student_friends/{id} {
      allow read, write: if isVerifiedUser() && (id.startsWith(request.auth.uid));
    }

    match /ai_query_logs/{id} {
      allow read, write: if isVerifiedUser() && (isParticipant(resource.data) || isIdParticipant(id));
    }

    match /firestore_deleted_items/{id} {
      allow read, write: if isAdmin();
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
