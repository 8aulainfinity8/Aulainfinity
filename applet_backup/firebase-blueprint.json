{
  "entities": {
    "users": {
      "title": "users",
      "description": "Perfiles globales de usuarios con datos de cuenta y rol (student, teacher, admin)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "firebaseUid": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "students": {
      "title": "students",
      "description": "Perfiles específicos de alumnos con cursos matriculados y datos personales",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "enrolledCourseIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "email"]
    },
    "teachers": {
      "title": "teachers",
      "description": "Perfiles de profesores con materias impartidas, biografía y especialidades",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "coursesTaughtIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "email"]
    },
    "admins": {
      "title": "admins",
      "description": "Cuentas con permisos de administración",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "courses": {
      "title": "courses",
      "description": "Cursos y asignaturas disponibles en la plataforma con lecciones y material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "videos": {
      "title": "videos",
      "description": "Vídeos educativos y lecciones grabadas de asignaturas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "courseId": { "type": "string" }
      },
      "required": ["id", "title", "url"]
    },
    "student_course_progress": {
      "title": "student_course_progress",
      "description": "Registro de lecciones completadas, calificaciones y progreso por alumno y curso",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "courseId": { "type": "string" },
        "completedLessonIds": { "type": "array", "items": { "type": "string" } },
        "percentage": { "type": "number" }
      },
      "required": ["studentId", "courseId"]
    },
    "firestore_tutoring_requests": {
      "title": "firestore_tutoring_requests",
      "description": "Solicitudes de tutoría reservadas por los estudiantes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "subjectName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentId", "subjectName"]
    },
    "firestore_peer_messages": {
      "title": "firestore_peer_messages",
      "description": "Mensajes de chat privado en tiempo real entre alumnos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["conversationId", "senderId", "text"]
    },
    "firestore_direct_messages": {
      "title": "firestore_direct_messages",
      "description": "Mensajes de chat directo entre alumno y profesor/administrador",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["conversationId", "senderId", "text"]
    },
    "firestore_teacher_messages": {
      "title": "firestore_teacher_messages",
      "description": "Mensajes del canal del claustro de profesores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["senderId", "text"]
    },
    "firestore_course_messages": {
      "title": "firestore_course_messages",
      "description": "Mensajes de chat grupal del curso",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["courseId", "senderId", "text"]
    },
    "firestore_conversations": {
      "title": "firestore_conversations",
      "description": "Estado y metadatos de conversaciones de chat directo (soporte/profesores/alumnos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageTimestamp": { "type": "string" },
        "unreadByAdmin": { "type": "boolean" },
        "unreadByTeacher": { "type": "boolean" },
        "unreadByStudent": { "type": "boolean" }
      },
      "required": ["id"]
    },
    "firestore_closed_conversations": {
      "title": "firestore_closed_conversations",
      "description": "Registro de conversaciones cerradas por soporte",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "closedAt": { "type": "string" },
        "closedBy": { "type": "string" }
      },
      "required": ["id"]
    },
    "firestore_peer_conversations": {
      "title": "firestore_peer_conversations",
      "description": "Estado y metadatos de chats privados entre alumnos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessageText": { "type": "string" },
        "lastMessageTimestamp": { "type": "string" },
        "unreadByStudentId": { "type": "object" }
      },
      "required": ["id", "participantIds"]
    },
    "firestore_agenda_events": {
      "title": "firestore_agenda_events",
      "description": "Eventos de la agenda estudiantil y fechas de exámenes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "studentId", "title", "date"]
    },
    "firestore_comments": {
      "title": "firestore_comments",
      "description": "Comentarios y dudas en lecciones en vídeo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "videoId": { "type": "string" },
        "author": { "type": "object" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "videoId", "text"]
    },
    "firestore_topic_requests": {
      "title": "firestore_topic_requests",
      "description": "Solicitudes de nuevos temas por parte de los alumnos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "topic": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "topic"]
    },
    "firestore_student_answers": {
      "title": "firestore_student_answers",
      "description": "Resultados de cuestionarios y exámenes completados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "videoId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" }
      },
      "required": ["id", "studentId", "videoId"]
    },
    "infinity_transactions": {
      "title": "infinity_transactions",
      "description": "Historial de recargas y consumos de créditos/Infinitys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "studentId", "amount", "type"]
    },
    "student_payments": {
      "title": "student_payments",
      "description": "Registro de cobros de suscripciones y tutorías a alumnos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "concept": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "studentId", "amount"]
    },
    "student_expenses": {
      "title": "student_expenses",
      "description": "Gastos acumulados por estudiante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "studentId", "amount"]
    },
    "teacher_payments": {
      "title": "teacher_payments",
      "description": "Pagos y honorarios transferidos a profesores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "teacherId", "amount"]
    },
    "firestore_quizzes": {
      "title": "firestore_quizzes",
      "description": "Catálogo de cuestionarios y autoevaluaciones interactivos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "questions": { "type": "array" }
      },
      "required": ["id", "title"]
    },
    "student_friends": {
      "title": "student_friends",
      "description": "Conexiones y amistades entre alumnos",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "friendId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["studentId", "friendId"]
    },
    "ai_query_logs": {
      "title": "ai_query_logs",
      "description": "Historial de consultas dirigidas al Tutor IA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "prompt"]
    },
    "firestore_deleted_items": {
      "title": "firestore_deleted_items",
      "description": "Registro de borrados sincronizados para purga en clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "type"]
    },
    "firestore_user_seen_states": {
      "title": "firestore_user_seen_states",
      "description": "Marcadores de notificaciones y novedades leídas por usuario",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastSeenTimestamp": { "type": "string" }
      },
      "required": ["userId"]
    },
    "whatsapp_queue": {
      "title": "whatsapp_queue",
      "description": "Cola de mensajes pendientes de notificación por WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "phone", "message"]
    },
    "whatsapp_logs": {
      "title": "whatsapp_logs",
      "description": "Historial de entrega y estado de notificaciones WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "phone"]
    },
    "voiceRooms": {
      "title": "voiceRooms",
      "description": "Salas de voz y videollamadas con participantes activos y estado",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "active": { "type": "boolean" },
        "participants": { "type": "array" }
      },
      "required": ["courseId"]
    },
    "rooms": {
      "title": "rooms",
      "description": "Salas de señalización WebRTC para llamadas P2P de audio y vídeo",
      "type": "object",
      "properties": {
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "active": { "type": "boolean" }
      }
    },
    "whiteboards": {
      "title": "whiteboards",
      "description": "Estado y trazos de pizarra interactiva colaborativa por curso/sala",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "whiteboardMeta": {
      "title": "whiteboardMeta",
      "description": "Metadatos y configuración de la pizarra interactiva",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "whiteboardCursors": {
      "title": "whiteboardCursors",
      "description": "Posición en tiempo real de cursores de participantes en la pizarra",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "userName": { "type": "string" }
      }
    },
    "classRecordings": {
      "title": "classRecordings",
      "description": "Grabaciones de sesiones de clase almacenadas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "app_config": {
      "title": "app_config",
      "description": "Configuración global de la plataforma (precios, horarios, credenciales de WhatsApp, etc.)",
      "type": "object",
      "properties": {
        "subscriptionPrice": { "type": "number" },
        "tutoringPrice": { "type": "number" },
        "bizumNumber": { "type": "string" },
        "whatsappMode": { "type": "string" },
        "evolutionInstanceUrl": { "type": "string" },
        "evolutionApiKey": { "type": "string" }
      }
    },
    "test": {
      "title": "test",
      "description": "Documentos de diagnóstico y prueba de conectividad",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "Colección de usuarios de la plataforma"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/students" },
      "description": "Colección de alumnos"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/teachers" },
      "description": "Colección de profesores"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admins" },
      "description": "Colección de administradores"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/courses" },
      "description": "Catálogo de cursos y asignaturas"
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/videos" },
      "description": "Catálogo de vídeos educativos"
    },
    "/student_course_progress/{progressId}": {
      "schema": { "$ref": "#/entities/student_course_progress" },
      "description": "Progreso de estudiantes en cursos"
    },
    "/firestore_tutoring_requests/{requestId}": {
      "schema": { "$ref": "#/entities/firestore_tutoring_requests" },
      "description": "Solicitudes de tutorías privadas"
    },
    "/firestore_peer_messages/{msgId}": {
      "schema": { "$ref": "#/entities/firestore_peer_messages" },
      "description": "Mensajes de chat privado entre alumnos"
    },
    "/firestore_direct_messages/{msgId}": {
      "schema": { "$ref": "#/entities/firestore_direct_messages" },
      "description": "Mensajes directos entre alumnos y profesores/soporte"
    },
    "/firestore_teacher_messages/{msgId}": {
      "schema": { "$ref": "#/entities/firestore_teacher_messages" },
      "description": "Mensajes del claustro de profesores"
    },
    "/firestore_course_messages/{msgId}": {
      "schema": { "$ref": "#/entities/firestore_course_messages" },
      "description": "Mensajes de grupos de curso"
    },
    "/firestore_conversations/{id}": {
      "schema": { "$ref": "#/entities/firestore_conversations" },
      "description": "Metadatos y badges de conversaciones directas"
    },
    "/firestore_closed_conversations/{id}": {
      "schema": { "$ref": "#/entities/firestore_closed_conversations" },
      "description": "Conversaciones cerradas de soporte"
    },
    "/firestore_peer_conversations/{id}": {
      "schema": { "$ref": "#/entities/firestore_peer_conversations" },
      "description": "Metadatos de chats entre alumnos"
    },
    "/firestore_agenda_events/{id}": {
      "schema": { "$ref": "#/entities/firestore_agenda_events" },
      "description": "Eventos de agenda y exámenes"
    },
    "/firestore_comments/{id}": {
      "schema": { "$ref": "#/entities/firestore_comments" },
      "description": "Comentarios en lecciones en vídeo"
    },
    "/firestore_topic_requests/{id}": {
      "schema": { "$ref": "#/entities/firestore_topic_requests" },
      "description": "Peticiones de temas por alumnos"
    },
    "/firestore_student_answers/{id}": {
      "schema": { "$ref": "#/entities/firestore_student_answers" },
      "description": "Resultados de exámenes y autoevaluaciones"
    },
    "/infinity_transactions/{id}": {
      "schema": { "$ref": "#/entities/infinity_transactions" },
      "description": "Transacciones de créditos Infinity"
    },
    "/student_payments/{id}": {
      "schema": { "$ref": "#/entities/student_payments" },
      "description": "Pagos realizados por alumnos"
    },
    "/student_expenses/{id}": {
      "schema": { "$ref": "#/entities/student_expenses" },
      "description": "Gastos acumulados por alumno"
    },
    "/teacher_payments/{id}": {
      "schema": { "$ref": "#/entities/teacher_payments" },
      "description": "Pagos realizados a profesores"
    },
    "/firestore_quizzes/{id}": {
      "schema": { "$ref": "#/entities/firestore_quizzes" },
      "description": "Cuestionarios y autoevaluaciones"
    },
    "/student_friends/{id}": {
      "schema": { "$ref": "#/entities/student_friends" },
      "description": "Red de contactos entre alumnos"
    },
    "/ai_query_logs/{id}": {
      "schema": { "$ref": "#/entities/ai_query_logs" },
      "description": "Registros de consultas al Tutor IA"
    },
    "/firestore_deleted_items/{id}": {
      "schema": { "$ref": "#/entities/firestore_deleted_items" },
      "description": "Registro de elementos borrados"
    },
    "/firestore_user_seen_states/{id}": {
      "schema": { "$ref": "#/entities/firestore_user_seen_states" },
      "description": "Marcadores de lectura de usuario"
    },
    "/whatsapp_queue/{id}": {
      "schema": { "$ref": "#/entities/whatsapp_queue" },
      "description": "Cola de envío de notificaciones WhatsApp"
    },
    "/whatsapp_logs/{id}": {
      "schema": { "$ref": "#/entities/whatsapp_logs" },
      "description": "Registros de envío WhatsApp"
    },
    "/voiceRooms/{roomId}": {
      "schema": { "$ref": "#/entities/voiceRooms" },
      "description": "Salas de llamada de voz en grupo"
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/rooms" },
      "description": "Salas de señalización WebRTC"
    },
    "/whiteboards/{courseId}": {
      "schema": { "$ref": "#/entities/whiteboards" },
      "description": "Pizarras interactivas por curso"
    },
    "/whiteboardMeta/{id}": {
      "schema": { "$ref": "#/entities/whiteboardMeta" },
      "description": "Metadatos de la pizarra interactiva"
    },
    "/whiteboardCursors/{id}": {
      "schema": { "$ref": "#/entities/whiteboardCursors" },
      "description": "Cursores en vivo en la pizarra"
    },
    "/classRecordings/{id}": {
      "schema": { "$ref": "#/entities/classRecordings" },
      "description": "Grabaciones de clases almacenadas"
    },
    "/app_config/{id}": {
      "schema": { "$ref": "#/entities/app_config" },
      "description": "Configuración global de la plataforma"
    },
    "/test/{id}": {
      "schema": { "$ref": "#/entities/test" },
      "description": "Colección de pruebas de conectividad"
    }
  }
}
